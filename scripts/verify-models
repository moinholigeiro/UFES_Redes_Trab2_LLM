#!/usr/bin/env python3
import hashlib
import json
import sys
from pathlib import Path

manifest = json.loads(Path(sys.argv[1] if len(sys.argv) > 1 else "models/manifest.json").read_text())
root = Path(sys.argv[2] if len(sys.argv) > 2 else "models")
failed = False
for item in manifest["models"]:
    path = root / item["file"]
    if not path.is_file():
        print(f"AUSENTE {path}")
        failed = True
        continue
    with path.open("rb") as stream:
        digest = hashlib.file_digest(stream, "sha256").hexdigest()
    ok = digest == item["sha256"]
    print(f"{'OK' if ok else 'DIVERGENTE'} {path} {digest}")
    failed |= not ok
raise SystemExit(1 if failed else 0)
